# Gemini is the default provider for the interview demo.
LLM_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite

# Optional OpenAI fallback/provider.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6

MAX_REPAIR_ATTEMPTS=1
MAX_RESULT_ROWS=5000

# Keep disabled for the Gemini-only demo so no OpenAI embedding call is required.
ENABLE_FEEDBACK_EMBEDDINGS=false
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
